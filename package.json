{
  "name": "rocklex-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "RockLex Studio - Minecraft 基岩版插件编辑器",
  "author": "LTypingCode",
  "build": {
    "appId": "com.rocklex.studio",
    "productName": "Rocklex Studio",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only && electron-builder",
    "build:win": "run-p type-check build-only && electron-builder --win",
    "build:linux": "run-p type-check build-only && electron-builder --linux",
    "build:mac": "run-p type-check build-only && electron-builder --mac",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@directus/vue-split-panel": "^0.8.13",
    "monaco-editor": "^0.34.0",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
