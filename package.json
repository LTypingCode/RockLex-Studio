{
  "name": "rocklex-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "RockLex Studio - Minecraft 基岩版插件编辑器",
  "author": "LTypingCode",
  "build": {
    "appId": "com.rocklex.studio",
    "productName": "Rocklex Studio",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        {
          "target": "dir"
        },
        {
          "target": "AppImage"
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only && electron-builder",
    "build:win": "run-p type-check build-only && electron-builder --win",
    "build:linux": "rm -rf /tmp/rocklex-build-out && run-p type-check build-only && electron-builder --linux --projectDir /tmp/rocklex-build-out && cp /tmp/rocklex-build-out/Rocklex-Studio-x86_64.AppImage release/",
    "build:linux-dir": "run-p type-check build-only && electron-builder --linux --dir",
    "build:linux-app": "cp -r release/linux-unpacked /tmp/appimage-build/dir && ARCH=x86_64 appimagetool /tmp/appimage-build/dir /tmp/appimage-build/release/Rocklex-Studio.AppImage && cp /tmp/appimage-build/release/Rocklex-Studio.AppImage release/ && rm -rf /tmp/appimage-build",
    "build:mac": "run-p type-check build-only && electron-builder --mac",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@directus/vue-split-panel": "^0.8.13",
    "monaco-editor": "^0.34.0",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
